--!strict
local H = require("./harness")
local DailyRules = require("../src/ReplicatedStorage/Shared/Gameplay/DailyRules")

H.begin()

local function day(n: number): number
	return n * 86400 + 3600
end

H.check("el día UTC parte en 86400 y la racha no se cobra dos veces", function()
	H.eq(DailyRules.dayIndex(0), 0)
	H.eq(DailyRules.dayIndex(86399), 0)
	H.eq(DailyRules.dayIndex(86400), 1)
	local streak, reason = DailyRules.nextStreak(0, 0, 10)
	H.eq(streak, 1)
	H.eq(reason, "start")
	streak, reason = DailyRules.nextStreak(10, 1, 10)
	H.eq(reason, "already")
	H.eq(streak, 1)
	streak, reason = DailyRules.nextStreak(10, 4, 11)
	H.eq(streak, 5)
	H.eq(reason, "continue")
	streak, reason = DailyRules.nextStreak(10, 6, 12)
	H.eq(streak, 1)
	H.eq(reason, "reset")
	streak, reason = DailyRules.nextStreak(10, 3, 9)
	H.eq(reason, "clock")
	H.eq(streak, 3)
end)

H.check("el día 7 del ciclo es Épica y el 8 vuelve al día 1", function()
	H.eq(DailyRules.cycleDay(1), 1)
	H.eq(DailyRules.cycleDay(7), 7)
	H.eq(DailyRules.isEpicDay(7), true)
	H.eq(DailyRules.isEpicDay(8), false)
	H.eq(DailyRules.cycleDay(8), 1)
	H.eq(DailyRules.rewardForStreak(7).PinataId, "pulpo")
	H.eq(DailyRules.rewardForStreak(1).PinataId, "estrellita")
	local board = DailyRules.board(DailyRules.dayIndex(day(3)))
	H.eq(#board, 3)
	local again = DailyRules.board(DailyRules.dayIndex(day(3)))
	H.eq(again[1].id, board[1].id)
	H.eq(again[2].goal, board[2].goal)
	H.truthy(DailyRules.questByIndex(4, 2))
	H.eq(DailyRules.questByIndex(4, 9), nil)
end)

H.check("reconectar el mismo unix no cambia la racha guardada", function()
	local today = DailyRules.dayIndex(1_700_000_000)
	local streak, reason = DailyRules.nextStreak(today - 1, 2, today)
	H.eq(reason, "continue")
	H.eq(streak, 3)
	local kept, again = DailyRules.nextStreak(today, streak, today)
	H.eq(again, "already")
	H.eq(kept, 3)
end)

H.finish()
