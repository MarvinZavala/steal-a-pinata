--!strict
local H = require("./harness")
local Events = require("../src/ReplicatedStorage/Shared/Config/Events")
local EventCalendar = require("../src/ReplicatedStorage/Shared/Gameplay/EventCalendar")

H.begin()

local rules = Events.PosadasPinateras

local function softSnap()
	return EventCalendar.snapshot(rules.StartUnix, false)
end

local function ymd(unix: number): string
	local year, month, day = EventCalendar.ymd(unix)
	return string.format("%04d-%02d-%02d", year, month, day)
end

H.check("las fechas UTC del evento caen en el día civil publicado", function()
	H.eq(ymd(rules.StartUnix), "2026-12-04")
	H.eq(ymd(rules.PosadasUnix), "2026-12-11")
	H.eq(ymd(rules.NavidadUnix), "2026-12-24")
	H.eq(ymd(rules.NavidadEndUnix), "2026-12-26")
	H.eq(ymd(rules.NewYearUnix), "2026-12-31")
	H.eq(ymd(rules.NewYearEndUnix), "2027-01-01")
	H.eq(ymd(rules.ReyesUnix), "2027-01-06")
	H.eq(ymd(rules.EndUnix), "2027-01-07")
	H.eq(ymd(rules.AdventEndUnix), "2026-12-25")
end)

H.check("fuera de ventana está apagado y el 7 de enero convierte", function()
	local before = EventCalendar.snapshot(rules.StartUnix - 1, false)
	H.eq(before.active, false)
	H.eq(before.phase, "off")
	H.eq(before.convert, false)
	H.eq(before.decor, false)
	local after = EventCalendar.snapshot(rules.EndUnix, false)
	H.eq(after.active, false)
	H.eq(after.convert, true)
	H.eq(after.fiestaVariant, "fiesta")
	local last = EventCalendar.snapshot(rules.EndUnix - 1, false)
	H.eq(last.active, true)
	H.eq(last.phase, "reyes")
	H.eq(last.convert, false)
end)

H.check("cada fase prende el vestido, la tienda y la variante de fiesta", function()
	local soft = EventCalendar.snapshot(rules.StartUnix, false)
	H.eq(soft.phase, "soft")
	H.eq(soft.decor, true)
	H.eq(soft.runway, true)
	H.eq(soft.shop, false)
	H.eq(soft.advent, false)
	H.eq(soft.parade, false)
	H.eq(soft.fiestaVariant, "fiesta")

	local posada = EventCalendar.snapshot(rules.PosadasUnix, false)
	H.eq(posada.phase, "posadas")
	H.eq(posada.shop, true)
	H.eq(posada.parade, true)
	H.eq(posada.advent, true)
	H.eq(posada.mutation, false)
	H.eq(posada.gift, false)
	H.eq(posada.fiestaVariant, "posada")

	local navidad = EventCalendar.snapshot(rules.NavidadUnix, false)
	H.eq(navidad.phase, "navidad")
	H.eq(navidad.mutation, true)
	H.eq(navidad.gift, true)
	H.eq(navidad.advent, true)
	H.eq(navidad.fiestaVariant, "posada")

	local christmasDay = EventCalendar.snapshot(rules.NavidadEndUnix - 1, false)
	H.eq(christmasDay.phase, "navidad")
	H.eq(christmasDay.advent, false)
	H.eq(christmasDay.gift, true)

	local between = EventCalendar.snapshot(rules.NavidadEndUnix, false)
	H.eq(between.phase, "posadas")
	H.eq(between.shop, true)

	local newYear = EventCalendar.snapshot(rules.NewYearUnix, false)
	H.eq(newYear.phase, "newyear")
	H.eq(newYear.fiestaVariant, "newyear")
	H.eq(newYear.gift, false)

	local reyes = EventCalendar.snapshot(rules.ReyesUnix, false)
	H.eq(reyes.phase, "reyes")
	H.eq(reyes.fiestaVariant, "rosca")
	H.eq(reyes.shop, true)
end)

H.check("el override de Studio prende una fase sin convertir Bastones", function()
	H.eq(EventCalendar.isForced(true), true)
	H.eq(EventCalendar.isForced(false), false)
	H.eq(Events.ForceActive, false)
	local forced = EventCalendar.snapshot(rules.StartUnix - 100, true)
	H.eq(forced.forced, true)
	H.eq(forced.active, true)
	H.eq(forced.phase, "posadas")
	H.eq(forced.convert, false)
	H.eq(forced.shop, true)
	local during = EventCalendar.snapshot(rules.StartUnix, true)
	H.eq(during.phase, "soft")
	H.eq(during.convert, false)
	local late = EventCalendar.snapshot(rules.EndUnix + 10, true)
	H.eq(late.convert, false)
	H.eq(late.phase, "posadas")
	local navidad = EventCalendar.snapshot(rules.StartUnix - 100, true, "navidad")
	H.eq(navidad.phase, "navidad")
	H.eq(navidad.gift, true)
	H.eq(navidad.convert, false)
	local junk = EventCalendar.snapshot(rules.StartUnix - 100, true, "nope")
	H.eq(junk.phase, "posadas")
end)

H.check("Renito sale en la pasarela al 0.5% y la mutación solo en Navidad", function()
	local soft = EventCalendar.snapshot(rules.StartUnix, false)
	H.eq(EventCalendar.runwayHit(soft, 0.004), true)
	H.eq(EventCalendar.runwayHit(soft, 0.005), false)
	H.eq(EventCalendar.mutationHit(soft, 0), false)
	local navidad = EventCalendar.snapshot(rules.NavidadUnix, false)
	H.eq(EventCalendar.mutationHit(navidad, 0.029), true)
	H.eq(EventCalendar.mutationHit(navidad, 0.03), false)
	local off = EventCalendar.snapshot(rules.StartUnix - 1, false)
	H.eq(EventCalendar.runwayHit(off, 0), false)
end)

H.check("el día 24 da Renito si faltan 3 o menos", function()
	local first = EventCalendar.adventReward(11, 0)
	H.eq(first.bastones, rules.AdventBastonesBase)
	H.eq(first.pinataId, nil)
	H.eq(first.finale, false)
	local kept = EventCalendar.adventReward(24, 3)
	H.eq(kept.pinataId, "renito")
	H.eq(kept.bastones, rules.AdventFinaleBonus)
	local missed = EventCalendar.adventReward(24, 4)
	H.eq(missed.pinataId, nil)
	H.eq(missed.bastones, rules.AdventFinaleBastones)
	H.eq(EventCalendar.missesBefore(0, 11), 0)
	H.eq(EventCalendar.missesBefore(0, 12), 1)
	local all = 0
	for day = 11, 23 do
		all = bit32.bor(all, EventCalendar.adventBit(day))
	end
	H.eq(EventCalendar.missesBefore(all, 24), 0)
	local snap = EventCalendar.snapshot(rules.NavidadUnix, false)
	H.eq(EventCalendar.adventDay(rules.NavidadUnix, snap), 24)
	local early = EventCalendar.snapshot(rules.PosadasUnix, false)
	H.eq(EventCalendar.adventDay(rules.PosadasUnix, early), 11)
	H.eq(EventCalendar.adventDay(rules.StartUnix, softSnap()), nil)
end)

H.check("los Bastones se vuelven Dulces una sola vez", function()
	local data = { Bastones = 10, Dulces = 5, BastonesSettled = false }
	local changed, gain = EventCalendar.applySettle(data, rules.EndUnix - 1, false, 100000)
	H.eq(changed, false)
	H.eq(gain, 0)
	H.eq(data.Bastones, 10)
	changed, gain = EventCalendar.applySettle(data, rules.EndUnix, false, 100000)
	H.eq(changed, true)
	H.eq(gain, 200)
	H.eq(data.Dulces, 205)
	H.eq(data.Bastones, 0)
	H.eq(data.BastonesSettled, true)
	local again, againGain = EventCalendar.applySettle(data, rules.EndUnix + 5, false, 100000)
	H.eq(again, false)
	H.eq(againGain, 0)
	local forced = { Bastones = 4, Dulces = 0, BastonesSettled = false }
	local forcedChanged = EventCalendar.applySettle(forced, rules.EndUnix, true, 100000)
	H.eq(forcedChanged, false)
	H.eq(forced.Bastones, 4)
	local capped = { Bastones = 10, Dulces = 90, BastonesSettled = false }
	local _, cappedGain = EventCalendar.applySettle(capped, rules.EndUnix, false, 100)
	H.eq(cappedGain, 10)
	H.eq(capped.Dulces, 100)
	H.eq(capped.Bastones, 0)
end)

H.finish()
