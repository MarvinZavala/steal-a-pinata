--!strict
local H = require("./harness")
local MutationVisual = require("../src/ReplicatedStorage/Shared/Gameplay/MutationVisual")

H.begin()

local function nearRgb(actual: MutationVisual.Rgb, r: number, g: number, b: number)
	H.near(actual.r, r, 1e-4)
	H.near(actual.g, g, 1e-4)
	H.near(actual.b, b, 1e-4)
end

H.check("solo Dorada y Arcoíris tienen visual", function()
	H.eq(MutationVisual.kind("Golden"), "Golden")
	H.eq(MutationVisual.kind("Rainbow"), "Rainbow")
	H.eq(MutationVisual.kind("Christmas"), nil)
	H.eq(MutationVisual.kind("None"), nil)
	H.eq(MutationVisual.kind(""), nil)
	H.eq(MutationVisual.kind(nil), nil)
	H.eq(MutationVisual.TAG, "MutatedPinata")
end)

H.check("el cuerpo dorado es Foil y el aura se queda en Neon", function()
	local body = MutationVisual.paintFor("Golden", "body")
	local aura = MutationVisual.paintFor("Golden", "aura")
	H.truthy(body)
	H.truthy(aura)
	if body and aura then
		H.eq(body.material, "Foil")
		H.eq(body.tint, "gold")
		H.eq(aura.material, "Neon")
		H.eq(aura.tint, "gold")
	end
	H.eq(MutationVisual.paintFor("Golden", "skip"), nil)
	H.eq(MutationVisual.paintFor("Christmas", "body"), nil)
	H.eq(MutationVisual.paintFor("None", "aura"), nil)
end)

H.check("el arcoíris cicla el color y no aplana el material del cuerpo", function()
	local body = MutationVisual.paintFor("Rainbow", "body")
	local aura = MutationVisual.paintFor("Rainbow", "aura")
	H.truthy(body)
	H.truthy(aura)
	if body and aura then
		H.eq(body.material, nil)
		H.eq(body.tint, "cycle")
		H.eq(aura.material, "Neon")
		H.eq(aura.tint, "cycle")
	end
end)

H.check("el oro de la paleta no depende del tiempo", function()
	local gold = MutationVisual.tintRgb("gold", 0, 0)
	local later = MutationVisual.tintRgb("gold", 99, 0.4)
	H.truthy(gold)
	H.truthy(later)
	if gold and later then
		nearRgb(gold, 1, 194 / 255, 46 / 255)
		H.near(later.r, gold.r)
		H.near(later.g, gold.g)
		H.near(later.b, gold.b)
	end
	local warm = MutationVisual.lightRgb("Golden", 10)
	H.truthy(warm)
	if warm then
		nearRgb(warm, 1, 216 / 255, 77 / 255)
	end
end)

H.check("el matiz da la vuelta al período y se reparte en el cuerpo", function()
	local period = MutationVisual.RAINBOW_PERIOD
	H.near(MutationVisual.hueAt(0, period, 0), 0)
	H.near(MutationVisual.hueAt(period, period, 0), 0)
	H.near(MutationVisual.hueAt(period / 2, period, 0), 0.5)
	H.near(MutationVisual.hueAt(0, period, 0.25), 0.25)
	H.near(MutationVisual.hueAt(-period / 2, period, 0), 0.5)
	H.eq(MutationVisual.phaseForIndex(1, 1), 0)
	H.near(MutationVisual.phaseForIndex(1, 4), 0)
	H.near(MutationVisual.phaseForIndex(2, 4), 0.25)
	H.near(MutationVisual.phaseForIndex(4, 4), 0.75)
	local a = MutationVisual.rainbowRgb(0, 0)
	local b = MutationVisual.rainbowRgb(0, 0.5)
	local mid = MutationVisual.rainbowRgb(period / 2, 0)
	H.truthy(math.abs(a.r - b.r) + math.abs(a.g - b.g) + math.abs(a.b - b.b) > 0.2)
	H.truthy(math.abs(a.r - mid.r) + math.abs(a.g - mid.g) + math.abs(a.b - mid.b) > 0.2)
	H.near(MutationVisual.hueAt(period * 3 + period / 2, period, 0), 0.5)
end)

H.check("hsv cubre rojo, cian y el blanco", function()
	nearRgb(MutationVisual.hsvToRgb(0, 1, 1), 1, 0, 0)
	nearRgb(MutationVisual.hsvToRgb(1, 1, 1), 1, 0, 0)
	nearRgb(MutationVisual.hsvToRgb(0.5, 1, 1), 0, 1, 1)
	nearRgb(MutationVisual.hsvToRgb(0, 0, 1), 1, 1, 1)
	nearRgb(MutationVisual.hsvToRgb(0.25, 1, 0), 0, 0, 0)
end)

H.check("la cara y la raíz no se pintan; el cuerpo oscuro grande sí", function()
	H.eq(MutationVisual.paintRole("Root", 0, 0.5, 4, 40), "skip")
	H.eq(MutationVisual.paintRole("Body", 1, 0.5, 40, 40), "skip")
	H.eq(MutationVisual.paintRole("f_eyeL", 0, 0.5, 1, 40), "skip")
	H.eq(MutationVisual.paintRole("f_mouth", 0, 0.2, 1, 40), "skip")
	H.eq(MutationVisual.paintRole("lid", 0, 0.4, 0.2, 40), "skip")
	H.eq(MutationVisual.paintRole("speck", 0, 0.02, 0.2, 40), "skip")
	H.eq(MutationVisual.paintRole("glint", 0, 0.98, 0.15, 40), "skip")
	H.eq(MutationVisual.paintRole("Body", 0, 0.05, 40, 40), "body")
	H.eq(MutationVisual.paintRole("fringe", 0, 0.05, 8, 40), "body")
	H.eq(MutationVisual.paintRole("Neon", 0, 0.8, 5, 40), "aura")
	H.eq(MutationVisual.paintRole("toro_Neon", 0, 0.8, 2, 40), "aura")
	H.eq(MutationVisual.paintRole("Body", 0, 0.5, 30, 30), "body")
end)

H.check("la calidad baja y menos movimiento achican las chispas sin pasar de 40", function()
	H.eq(MutationVisual.qualityFromName("QualityLevel1"), 1)
	H.eq(MutationVisual.qualityFromName("QualityLevel10"), 10)
	H.eq(MutationVisual.qualityFromName("Automatic"), 0)
	H.eq(MutationVisual.qualityFromName(nil), 0)
	H.eq(MutationVisual.levelFromQuality("Level01"), 1)
	H.eq(MutationVisual.levelFromQuality("Level10"), 10)
	H.eq(MutationVisual.levelFromQuality("Level21"), 10)
	H.eq(MutationVisual.qualityFromNames("Automatic", "Level01"), 1)
	H.eq(MutationVisual.qualityFromNames("QualityLevel8", "Level03"), 3)
	H.eq(MutationVisual.qualityFromNames("QualityLevel2", "Level10"), 2)
	H.eq(MutationVisual.qualityFromNames("QualityLevel10", nil), 10)

	local full = MutationVisual.fxProfile(10, false)
	local low = MutationVisual.fxProfile(1, false)
	local calm = MutationVisual.fxProfile(10, true)
	H.eq(full.particleScale, 1)
	H.eq(full.light, true)
	H.eq(full.hueStep, 0)
	H.eq(low.particleScale, 0.35)
	H.eq(low.light, false)
	H.near(low.hueStep, 0.12)
	H.eq(calm.particleScale, 0.25)
	H.eq(calm.light, false)
	H.near(calm.hueStep, 0.25)
	H.eq(MutationVisual.fxProfile(3, false).light, true)
	H.eq(MutationVisual.fxProfile(2, false).light, false)

	H.eq(MutationVisual.particleRate(MutationVisual.GOLDEN_RATE, 10, false), 8)
	H.eq(MutationVisual.particleRate(MutationVisual.GOLDEN_RATE, 0, false), 8)
	H.eq(MutationVisual.particleRate(MutationVisual.GOLDEN_RATE, 1, false), 3)
	H.eq(MutationVisual.particleRate(MutationVisual.RAINBOW_RATE, 10, true), 3)
	H.eq(MutationVisual.particleRate(1000, 1, false), MutationVisual.MAX_RATE)
	H.eq(MutationVisual.particleRate(1000, 10, true), MutationVisual.MAX_RATE)
	H.eq(MutationVisual.particleRate(0, 10, false), 0)
	H.truthy(MutationVisual.MAX_RATE * MutationVisual.LIFE_MAX <= MutationVisual.MAX_ALIVE)
	H.eq(MutationVisual.MAX_ALIVE, 40)
	local stops = MutationVisual.sparkleStops("Rainbow")
	H.truthy(stops)
	if stops then
		H.eq(#stops, 6)
		H.eq(stops[1].t, 0)
		H.eq(stops[#stops].t, 1)
		H.near(stops[1].r, stops[#stops].r)
	end
	local goldStops = MutationVisual.sparkleStops("Golden")
	H.truthy(goldStops)
	if goldStops then
		H.eq(#goldStops, 2)
	end
	H.eq(MutationVisual.sparkleStops("Christmas"), nil)
end)

H.finish()
